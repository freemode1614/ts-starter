{
  "name": "ts-starter",
  "version": "0.1.0",
  "description": "Project starter for TypeScript",
  "keywords": [
    "ts-starter",
    "typescript library",
    "typescript library template"
  ],
  "license": "MIT",
  "files": [
    "npm",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./npm/index.mjs",
  "module": "./npm/index.mjs",
  "types": "./npm/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./npm/index.d.mts",
        "default": "./npm/index.mjs"
      },
      "default": {
        "types": "./npm/index.d.mts",
        "default": "./npm/index.mjs"
      }
    },
    "./*": {
      "import": {
        "types": "./npm/*.d.mts",
        "default": "./npm/*.mjs"
      },
      "default": {
        "types": "./npm/*.d.mts",
        "default": "./npm/*.mjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "build:check": "attw --pack .",
    "prepublishOnly": "pnpm build",
    "test": "vitest --watch=false",
    "test:coverage": "vitest --watch=false --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "typedoc": "typedoc --options typedoc.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.3",
    "lint-staged": "^17.6.0",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mjs,cjs}": [
      "biome check --write ."
    ],
    "*.{json,md,yml,yaml}": [
      "biome format --write ."
    ]
  },
  "packageManager": "pnpm@11.5.1"
}
